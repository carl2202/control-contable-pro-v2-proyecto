# Backups
AUTO_BACKUP=true
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_ON_START=false

# Security challenge
PORT=3000
SESSION_SECRET=
# Opcional; mantenga estable este valor para acelerar las búsquedas de PIN.
PIN_LOOKUP_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
DEMO_OTP=true
# Recovery delivery webhook must accept POST JSON with channel, target, code, expiresInMinutes, displayName.
RECOVERY_WEBHOOK_URL=
RECOVERY_WEBHOOK_TOKEN=

# Turso/libSQL (leave both empty to use local data/control_contable.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
